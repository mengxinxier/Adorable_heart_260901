# ==================== YSS 宣传鼓动部界面（原 interface/YSS_gui.gui） ====================
##宣传部门
@POSTER_LEFT_X = 20
@POSTER_CENTER_X = 179
@POSTER_RIGHT_X = 338
@POSTERS_Y = 16

guiTypes = {
	containerWindowType = {
		name = "YSS_publicity_campaigns_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 500 height = 228 }
		# 宣传栏底图（474x208，含三枚内凹海报框，居中留白不压边缘）
		iconType = {
			name = "YSS_xc_ui_background"
			spriteType = GFX_YSS_xuanchuan_icon
			position = { x = 8 y = 8 }
			scale = 1
		}
		# POSTER LEFT
		iconType = {
			name = "YSS_publicity_solt_A"
			position = { x = @POSTER_LEFT_X y = @POSTERS_Y }
		}
		# POSTER CENTER
		iconType = {
			name = "YSS_publicity_solt_B"
			position = { x = @POSTER_CENTER_X y = @POSTERS_Y }
		}
		# POSTER RIGHT
		iconType = {
			name = "YSS_publicity_solt_C"
			position = { x = @POSTER_RIGHT_X y = @POSTERS_Y }
		}
	}
}
