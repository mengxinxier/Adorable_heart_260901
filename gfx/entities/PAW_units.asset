    }
    state = { name = "attack"  animation = "MazeAttack01"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "attack"  chance = 5
        event = { time = 0  sound = { soundeffect = "Cerydre_MazeAttack01" } }
    }

    state = { name = "defend"  animation = "MazeAttack01"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "defend"  chance = 1
        event = { time = 0  sound = { soundeffect = "Cerydre_MazeAttack01" } }
    }
    state = { name = "defend"  animation = "MazeSkill01"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "defend"  chance = 2
        event = { time = 0  sound = { soundeffect = "Cerydra_MazeSkill01" } }
    }


    state = { name = "support_attack"  animation = "MazeSkill01"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "support_attack"  chance = 1
        event = { time = 0  sound = { soundeffect = "Cerydra_MazeSkill01" } }
    }
    state = { name = "support_attack"  animation = "MazeSkill01"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "support_attack"  chance = 1
        event = { time = 0  sound = { soundeffect = "Cerydra_MazeSkill01" } }
    }
