entity = {
	name = "al_5266f473_c547_4a67_a525_fe4c3602aff9_infantry_2_entity"
	pdxmesh = "al_5266f473_c547_4a67_a525_fe4c3602aff9_0_mesh"

	default_state = "idle"


	# ================================================================
	# COMBAT
	# ================================================================

	state = {
		name = "attack"
		animation = "charge_mg"
		animation_blend_time = 0.20
		animation_speed = 0.92
		looping = no
		next_state = "attack"
		chance = 2
		propagate_state = {
			rifle1 = "idle"
		}
	}

	state = {
		name = "attack"
		animation = "charge_mg_shoot"
		animation_blend_time = 0.20
		animation_speed = 0.94
		looping = no
		next_state = "attack"
		chance = 1
	}

	# Upright defensive posture
	state = {
		name = "defend"
		animation = "attack"
		animation_blend_time = 0.35
		animation_speed = 0.96
	}

	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.35
		animation_speed = 0.94
	}


	# ================================================================
	# MOVEMENT
	# ================================================================

	# IMPORTANT:
	# Use march_move for the normal move state too.
	# This keeps the same validated infantry skeleton/action and avoids
	# introducing a different skeleton or attachment coordinate system.

	state = {
		name = "move"
		animation = "march_move"
		animation_blend_time = 0.45
		animation_speed = 0.92
		chance = 1
		event = {
			sound = {
				soundeffect = "infantry_move_animation"
			}
		}
	}

	# Keep original march movement
	state = {
		name = "move"
		animation = "march_move"
		animation_blend_time = 0.45
		animation_speed = 0.92
		chance = 1
		event = {
			sound = {
				soundeffect = "infantry_move_animation"
			}
		}
	}

	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.35
		animation_speed = 0.92
	}

	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.30
		animation_speed = 0.94
	}


	# ================================================================
	# IDLE
	# ================================================================

	# Main upright idle
	state = {
		name = "idle"
		animation = "long_idle02"
		animation_blend_time = 2
		animation_speed = 0.4
		chance = 12
		looping = no
	}

	state = {
		name = "idle"
		animation = "long_idle02"
		animation_blend_time = 0.45
		animation_speed = 0.94
		chance = 4
		looping = no
	}

	# Cigarette idle
	state = {
		name = "idle"
		animation = "long_idle03"
		animation_blend_time = 0.50
		animation_speed = 0.92
		chance = 0
		looping = no

		propagate_state = {
			lighter = "smoke"
		}

		event = {
			time = 0
			node = "head"
			particle = "cigarette_smoke_particle"
			keep_particle = yes
		}
	}

	state = {
		name = "idle"
		animation = "long_idle04"
		animation_blend_time = 0.50
		animation_speed = 0.94
		chance = 5
		looping = no
	}

	state = {
		name = "idle"
		animation = "long_idle05"
		animation_blend_time = 0.50
		animation_speed = 0.94
		chance = 5
		looping = no
	}


	# ================================================================
	# TRAINING
	# ================================================================

	# Generic upright training
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.40
		animation_speed = 0.92
		chance = 2
		looping = no
	}

	# Aiming exercise
	state = {
		name = "training"
		animation = "aim_exercise"
		animation_blend_time = 0.40
		animation_speed = 0.92
		chance = 1
		looping = no
	}


	# ================================================================
	# ATTACHMENTS
	# ================================================================

	attach = {
		name = "rifle1"
		Right_Hand_node = "SOV_infantry_weapon_mg_right_entity"
	}

	attach = {
		name = "lighter"
		Right_Hand_node_4 = "lighter_entity"
	}

	attach = {
		name = "cigarette1"
		Right_Hand_node_2 = "cigarette_entity"
	}

	attach = {
		name = "cigarette_package1"
		Right_Hand_node_3 = "cigarette_package_entity"
	}


	scale = 0.8
}



