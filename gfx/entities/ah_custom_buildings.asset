# Placeholder map entities for Adorable Heart custom trade hub & canal buildings.
# These buildings render on the map via `always_shown = yes` + `special_icon` (2D pins)
# and have no 3D meshes; registering empty `building_<id>` entities silences startup
# "Building <id> doesn't have an entity" errors without altering map icons or spawning meshes.

entity = {
	name = "building_city_trading_center_world_class"
}

entity = {
	name = "building_city_trading_center_intercontinental"
}

entity = {
	name = "building_canal_suez"
}

entity = {
	name = "building_city_trading_center_regional"
}

entity = {
	name = "building_city_trading_center_geopolitical_chokepoint"
}

entity = {
	name = "building_canal_istanbul"
}

entity = {
	name = "building_city_trading_center_frontier_commercial_port"
}
